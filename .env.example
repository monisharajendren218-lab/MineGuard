# MineGuard System Environment Variables

# Backend API Configuration
PORT=5000
DATABASE_URL=sqlite://./data/mineguard.db

# MQTT Broker Configuration for ESP32 Payload Receiver
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=mineguard/drone/DRONE-01/sensors
MQTT_USERNAME=
MQTT_PASSWORD=

# Live Camera Stream Gateway Configuration
CAMERA_STREAM_URL=http://192.168.1.100:81/stream

# Frontend Web Dashboard Environment
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000
